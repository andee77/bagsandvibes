+/* ==========================================================================
+   Buttons: readable in every state (2026-10-19). Kadence styles every
+   <button> coral with near-white text, turns it gold with near-white text
+   on hover/focus/active (2.0:1) and fades disabled buttons to 50%, and its
+   button rules win ties with ours. These rules pin each state:
+   - Filled coral (.btn-ticket: Pay, Send Request, Save, Submit...): ink
+     text, 5.7:1 at rest, hover, focus, click and while disabled
+     ("Sending...", "Redirecting to Stripe...").
+   - Outlined (.btn-ghost): cream on navy/ink (10.9:1, gold 5.8:1 on
+     hover); ink on the cream member pages (14.6:1, inverted on hover);
+     back to cream inside the navy panels on those pages.
+   ========================================================================== */
+.btn-ticket,
+.btn-ticket:is(:hover, :focus, :active, :visited),
+button.btn-ticket,
+button.btn-ticket:is(:hover, :focus, :active, :disabled) {
+  background: var(--coral);
+  color: var(--ink);
+  box-shadow: none;
+}
+.btn-ticket .ticket-notch { background: var(--ink); }
+button.btn:disabled {
+  opacity: 1;
+  cursor: not-allowed;
+}
+button.btn-ticket:disabled { cursor: progress; }
+
+/* Outlined, on navy/ink (the default). */
+button.btn-ghost,
+button.btn-ghost:disabled {
+  background: transparent;
+  border: 1px solid rgba(251,243,231,0.7);
+  color: var(--sand);
+  box-shadow: none;
+}
+.btn-ghost:is(:hover, :focus-visible, :active),
+button.btn-ghost:is(:hover, :focus, :active) {
+  background: transparent;
+  border-color: var(--gold);
+  color: var(--gold);
+  box-shadow: none;
+}
+
+/* Outlined, on the cream member pages. */
+body.checkedbags-gate .gate-main .btn-ghost,
+body.checkedbags-gate .gate-main button.btn-ghost:disabled {
+  background: transparent;
+  border: 1px solid rgba(22,35,43,0.7);
+  color: var(--ink);
+}
+body.checkedbags-gate .gate-main .btn-ghost:is(:hover, :focus, :active):not(:disabled) {
+  background: var(--ink);
+  border-color: var(--ink);
+  color: var(--sand);
+}
+
+/* ...but cream again inside the navy panels on those pages. */
