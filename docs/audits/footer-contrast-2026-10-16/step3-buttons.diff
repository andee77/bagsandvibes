+body.checkedbags-gate .gate-main :is(.trip-card, .rules-trip-card, .rules-agreement, .cbv-payment-card, .payment-card, .cbv-payment-disclaimer-banner, .cbv-exchange-rates-section, .cbv-schedule-appt-modal-inner, .request-status-card, .trip-request-form, .trip-detail-traveler-intake, .member-directory-card, .following-list-item, .board-row, .feed-trip-card, .feed-topic-row, .hub-board, .hub-notice, .hub-pod, .tip-card, .gate-card, .destination-card, .suggestion-row) button.btn-ghost:disabled {
+  background: transparent;
+  border-color: rgba(251,243,231,0.7);
+  color: var(--sand);
+}
+body.checkedbags-gate .gate-main :is(.trip-card, .rules-trip-card, .rules-agreement, .cbv-payment-card, .payment-card, .cbv-payment-disclaimer-banner, .cbv-exchange-rates-section, .cbv-schedule-appt-modal-inner, .request-status-card, .trip-request-form, .trip-detail-traveler-intake, .member-directory-card, .following-list-item, .board-row, .feed-trip-card, .feed-topic-row, .hub-board, .hub-notice, .hub-pod, .tip-card, .gate-card, .destination-card, .suggestion-row) .btn-ghost:is(:hover, :focus, :active):not(:disabled) {
