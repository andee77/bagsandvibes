+}
+
+body.cbv-lp .cbv-inc-leave-list li { margin: 0 !important; color: rgba(251, 243, 231, 0.88) !important; }
+
+body.cbv-lp .cbv-inc-leave-more { margin: 4px 0 0 !important; }
+
+body.cbv-lp .cbv-inc-leave-more a {
